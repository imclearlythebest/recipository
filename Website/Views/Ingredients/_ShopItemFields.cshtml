@model Website.Models.ShopItem

<hr />
<h4 style="color: var(--pico-primary);">Marketplace Logistics</h4>

<div class="grid">
    <label for="Price">
        Price ($)
        <input type="number" step="0.01" asp-for="Price" required />
    </label>

    <label for="Stock">
        Stock
        <input type="number" asp-for="Stock" required />
    </label>
</div>

<div class="grid">
    <label for="Moq">
        Minimum Order Quantity (MOQ)
        <input type="number" asp-for="Moq" />
    </label>

    <label for="Increment">
        Purchase Increment
        <input type="number" asp-for="Increment" />
    </label>
</div>

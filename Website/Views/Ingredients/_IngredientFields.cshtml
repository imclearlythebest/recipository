@model Website.Models.Ingredient
@using Website.Models

<div class="grid">
    <label for="Name">
        Name
        <input type="text" asp-for="Name" placeholder="e.g. Red Bell Pepper" required />
    </label>

    <label for="Type">
        Type
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<IngredientType>()">
            <option value="">Select Type</option>
        </select>
    </label>
</div>

<label for="Description">
    Description
    <textarea asp-for="Description" placeholder="Brief description..."></textarea>
</label>

<div class="grid">
    <label for="ImageUrl">
        Image URL
        <input type="text" asp-for="ImageUrl" placeholder="https://example.com/image.jpg" />
    </label>

    <label for="Calories">
        Calories (per unit)
        <input type="number" step="0.1" asp-for="Calories" />
    </label>
</div>

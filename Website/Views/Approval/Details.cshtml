@model Website.Models.Dtos.RecipeResponseDto

@{
    ViewData["Title"] = "Review: " + Model.Title;
    var history = ViewBag.History as List<Website.Models.Dtos.ApprovalHistoryDto> ?? new List<Website.Models.Dtos.ApprovalHistoryDto>();
}

<article style="padding: 2.5rem;">
    <h1 style="text-align:center; text-decoration:underline; margin-bottom:1rem;">@Model.Title</h1>
    <div style="display:flex; justify-content:center; margin-bottom:2rem;">
        <span class="badge warning">Pending Approval</span>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="color: var(--pico-form-element-invalid-border-color); margin-bottom: 1rem;">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
        </div>
    }

    <h4 style="margin-bottom:0.75rem;">Summary</h4>
    <p style="line-height:1.7; margin:0 0 1.5rem 0;">@Model.MainText</p>

    <h4 style="margin-bottom:0.75rem;">At a Glance</h4>
    <ul style="margin:0 0 1.5rem 1.25rem; padding:0; line-height:1.8;">
        <li><strong>Prep Time:</strong> @Model.PrepTime minutes</li>
        <li><strong>Cook Time:</strong> @Model.CookTime minutes</li>
        <li><strong>Servings:</strong> @Model.ServingSize</li>
        <li><strong>Difficulty:</strong> @Model.Difficulty</li>
        <li><strong>Estimated Calories:</strong> @Math.Round(Model.EstimatedCalories) cal</li>
    </ul>

    <hr style="margin:1.5rem 0;">

    <h4 style="margin-bottom:0.75rem;">Ingredients</h4>
    <ul style="margin:0 0 1rem 1.25rem; padding:0; line-height:1.8;">
        @foreach (var ing in Model.Ingredients)
        {
            <li style="margin-bottom:0.5rem;">
                <strong>@ing.IngredientName</strong> — @ing.Quantity @ing.Unit
                <span style="color: var(--pico-muted-color); font-size:0.9rem;">(@Math.Round(ing.TotalCalories) cal)</span>
            </li>
        }
    </ul>



    <hr style="margin:1.5rem 0;">

    <h4 style="margin-bottom:0.75rem;">Instructions</h4>
    <div style="white-space: pre-wrap; line-height:1.8;">@Model.Instructions</div>

    <div style="text-align: right; margin-top: 2rem;">
        <p class="text-muted" style="margin:0;">
            Recipe by <strong>@Model.AuthorName</strong> • <small>Submitted on @Model.CreatedAt.ToShortDateString()</small>
        </p>
    </div>

    @if (history.Any())
    {
        <section style="margin-top: 2rem;">
            <h3>Previous Review History</h3>
            <table class="striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Admin</th>
                        <th>Status</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in history)
                    {
                        <tr>
                            <td>@entry.ReviewedAt.ToShortDateString()</td>
                            <td>@entry.AdminName</td>
                            <td>
                                @if (entry.Status == "Approved")
                                {
                                    <span style="color: green;">@entry.Status</span>
                                }
                                else
                                {
                                    <span style="color: red;">@entry.Status</span>
                                }
                            </td>
                            <td>@entry.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <footer style="margin-top: 2rem; border-top: 1px solid var(--pico-muted-border-color); padding-top: 2rem;">
        <div class="grid">
            <section>
                <h4>Approve Recipe</h4>
                <p>This will make the recipe public for all users.</p>
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="primary">Approve & Publish</button>
                </form>
            </section>

            <section>
                <h4>Reject Recipe</h4>
                <p>Provide feedback to the author for revision.</p>
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                    <textarea name="reason" placeholder="Explain why the recipe is being rejected..." required minlength="10"></textarea>
                    <button type="submit" class="outline contrast">Reject & Send Feedback</button>
                </form>
            </section>
        </div>
        <div style="text-align: center; margin-top: 2rem;">
            <a asp-action="Index" class="outline secondary" role="button">Back to List</a>
        </div>
    </footer>
</article>
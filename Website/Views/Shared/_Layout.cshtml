<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/pico.sand.min.css">
  <link rel="stylesheet" href="/css/style.css" asp-append-version="true">
    @RenderSection("Styles", required: false)
    <title>@ViewData["Title"]</title>
  </head>

  <body>
    <header class="container">
      <nav>
        <ul>
          <li><strong>
            <a asp-controller="Home" asp-action="Index" style="text-decoration: none;">
              <span class="fas fa-utensils"></span> Recipository
            </a>
          </strong></li>
        </ul>
        <ul>
          @RenderSection("NavLinks", required: false)
        </ul>
      </nav>
    </header>

    <div class="middle container">
      <aside>
        <partial name="_LeftSidebar" />
      </aside>
      <main class="container">
        @RenderBody()
      </main>
      <aside>
        <partial name="_RightSidebar" />
      </aside>
    </div>

    <footer class="container">
      <nav aria-label="Footer">
        <ul>
          <li><a asp-controller="Home" asp-action="About">About</a></li>
          <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
          <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
        </ul>
      </nav>
      <small>© 2026 Recipository. All rights reserved.</small>
    </footer>
    <script src="/js/script.js"></script>
    @RenderSection("Scripts", required: false)
  </body>

</html>
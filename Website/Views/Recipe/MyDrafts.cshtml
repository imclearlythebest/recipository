@model List<Website.Models.Dtos.RecipeResponseDto>

@{
    ViewData["Title"] = "My Draft Recipes";
}

<article>
    <header style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1>My Draft Recipes</h1>
            <p>Recipes you're still working on. They are only visible to you.</p>
        </div>
        <a asp-action="Create" class="button primary">Create New Recipe</a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="color: var(--pico-form-element-valid-border-color); margin-bottom: 1rem;">
            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="color: var(--pico-form-element-invalid-border-color); margin-bottom: 1rem;">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div style="text-align: center; padding: 3rem 0;">
            <i class="fa-solid fa-file-signature" style="font-size: 4rem; color: var(--pico-muted-color); margin-bottom: 1rem; display: block;"></i>
            <h3>No drafts yet</h3>
            <p>You haven't started any recipe drafts. Why not share your favorite dish?</p>
            <a asp-action="Create" class="button">Create New Recipe</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="striped">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Created</th>
                        <th>Ingredients</th>
                        <th>Calories</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var recipe in Model)
                    {
                        <tr>
                            <td><strong>@recipe.Title</strong></td>
                            <td>@recipe.CreatedAt.ToShortDateString()</td>
                            <td>@recipe.Ingredients.Count</td>
                            <td>@Math.Round(recipe.EstimatedCalories) cal</td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    <a asp-action="Details" asp-route-id="@recipe.Id" class="outline secondary" role="button" title="View Details" style="padding: 0.25rem 0.5rem;"><i class="fa-solid fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@recipe.Id" class="outline primary" role="button" title="Edit Recipe" style="padding: 0.25rem 0.5rem;"><i class="fa-solid fa-pen-to-square"></i></a>
                                    <form asp-action="Submit" asp-route-id="@recipe.Id" method="post" style="margin: 0;">
                                        <button type="submit" class="outline success" title="Submit for Approval" style="padding: 0.25rem 0.5rem; width: auto;"><i class="fa-solid fa-paper-plane"></i></button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@recipe.Id" method="post" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');">
                                        <button type="submit" class="outline contrast" title="Delete Recipe" style="padding: 0.25rem 0.5rem; width: auto;"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</article>
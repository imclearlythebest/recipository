@model List<Website.Models.Dtos.RecipeResponseDto>

@{
    ViewData["Title"] = "My Draft Recipes";
}

<article>
    <header style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1>My Draft Recipes</h1>
            <p>Recipes you're still working on. They are only visible to you.</p>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="color: var(--pico-form-element-valid-border-color); margin-bottom: 1rem;">
            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="color: var(--pico-form-element-invalid-border-color); margin-bottom: 1rem;">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div style="text-align: center; padding: 3rem 0;">
            <i class="fa-solid fa-file-signature" style="font-size: 4rem; color: var(--pico-muted-color); margin-bottom: 1rem; display: block;"></i>
            <h3>No drafts yet</h3>
            <p>You haven't started any recipe drafts. Why not share your favorite dish?</p>
            <a asp-action="Create" class="button">Create New Recipe</a>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
            @foreach (var recipe in Model)
            {
                <article style="display: flex; flex-direction: column;">
                    <header>
                        <h3 style="margin-bottom: 0.5rem; word-break: break-word;">@recipe.Title</h3>
                        <p class="text-muted" style="margin: 0; font-size: 0.9rem;">@recipe.CreatedAt.ToShortDateString()</p>
                    </header>
                    <p style="flex: 1; margin: 0.75rem 0; color: var(--pico-muted-color); font-size: 0.9rem;">
                        <strong>@recipe.Ingredients.Count</strong> ingredients • <strong>@Math.Round(recipe.EstimatedCalories)</strong> cal
                    </p>
                    <footer style="display: flex; gap: 0.5rem; border-top: 1px solid var(--pico-muted-border-color); padding-top: 0.75rem;">
                        <a asp-action="Details" asp-route-id="@recipe.Id" class="secondary button" title="View Details" style="flex: 1; padding: 0.5rem; text-align: center; margin: 0; background: none; border: none; cursor: pointer;"><i class="fa-solid fa-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@recipe.Id" class="primary button" title="Edit Recipe" style="flex: 1; padding: 0.5rem; text-align: center; margin: 0; background: none; border: none; cursor: pointer;"><i class="fa-solid fa-pen-to-square"></i></a>
                        <form asp-action="Submit" asp-route-id="@recipe.Id" method="post" style="margin: 0; flex: 1;">
                            <button type="submit" title="Submit for Approval" style="padding: 0.5rem; width: 100%; margin: 0; background: none; border: none; color: var(--pico-form-element-valid-border-color); cursor: pointer;"><i class="fa-solid fa-paper-plane"></i></button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@recipe.Id" method="post" style="margin: 0; flex: 1;" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');">
                            <button type="submit" title="Delete Recipe" style="padding: 0.5rem; width: 100%; margin: 0; background: none; border: none; color: var(--pico-form-element-invalid-border-color); cursor: pointer;"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </footer>
                </article>
            }
        </div>
    }
</article>
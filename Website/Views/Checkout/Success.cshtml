@{
  ViewData["Title"] = "Order Success";
}

<main class="container">
  <article style="text-align: center; padding: 4rem 2rem;">
    <header>
      <span class="fas fa-circle-check" style="font-size: 5rem; color: var(--pico-ins-color); margin-bottom: 1.5rem;"></span>
      <h1>Order Placed Successfully!</h1>
    </header>

    <p style="font-size: 1.2rem;">
      Thank you for your purchase. Your ingredients are being prepared for delivery.
    </p>
    
    <div style="background: var(--pico-card-background-color); padding: 2rem; border-radius: 12px; border: 1px solid var(--pico-primary-background); margin: 2rem 0;">
      <h4 style="margin-bottom: 1rem;"><i class="fas fa-star" style="color: #ffc107;"></i> Rate the Recipes!</h4>
      <p>Your purchase included ingredients from recipe posts. Would you like to share your feedback by reviewing them?</p>
      <a href="/Home/Reviews" role="button" class="primary">Review Pending Recipes</a>
    </div>

    <footer style="margin-top: 2rem;">
      <div class="grid">
        <a href="/Marketplace" role="button" class="secondary outline">Back to Marketplace</a>
        <a href="/Home/Index" role="button" class="secondary outline">Go to Home</a>
      </div>
    </footer>
  </article>
</main>
@{
  ViewData["Title"] = "Order Success";
}

<main class="container">
  <article style="text-align: center; padding: 4rem 2rem;">
    <header>
      <span class="fas fa-circle-check" style="font-size: 5rem; color: var(--pico-ins-color); margin-bottom: 1.5rem;"></span>
      <h1>Order Placed Successfully!</h1>
    </header>

    <p style="font-size: 1.2rem;">
      Thank you for your purchase. Your ingredients are being prepared for delivery.
    </p>
    
    <p>
      You can view your order history in your profile settings.
    </p>

    <footer style="margin-top: 2rem;">
      <div class="grid">
        <a href="/Marketplace" role="button" class="primary">Back to Marketplace</a>
        <a href="/Home/Index" role="button" class="secondary outline">Go to Home</a>
      </div>
    </footer>
  </article>
</main>
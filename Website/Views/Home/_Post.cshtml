@model Recipe
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userVote = Model.Votes.FirstOrDefault(v => v.ApplicationUserId == currentUser?.Id);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<article>
    <header>
        <strong>@Model.Title</strong>
        <br />
        <a asp-controller="User" asp-action="Profile" asp-route-username="@Model.Author.UserName">
            <small>- @Model.Author.DisplayName</small>
        </a>
    </header>
    <p>@Model.MainText</p>
    <time datetime="@Model.CreatedAt.ToUniversalTime():O">@Model.CreatedAt.ToLocalTime()</time>
    <footer>
        <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
            @{
                var vc = new Website.Models.ViewModels.VoteControlsViewModel
                {
                    ContentId = Model.Id,
                    Score = Model.Score,
                    UserVote = userVote?.VoteType,
                    CanVote = currentUser != null,
                    ReturnUrl = returnUrl ?? string.Empty
                };
            }
            @await Html.PartialAsync("_VoteControls", vc)
            <a asp-controller="Home" asp-action="Post" asp-route-id="@Model.Id" class="secondary outline" title="Comments" style="margin: 0; padding: 0.5rem 0.75rem;">
                <span class="fas fa-comment"></span>
            </a>
        </div>
    </footer>
</article>


@model Content
<article>
    <p>@Model.MainText</p>
    <time datetime="@Model.CreatedAt">@Model.CreatedAt</time>
    <footer>
        <div role="group">
            <button><span class="fas fa-arrow-up" /></button>
            <button><span class="fas fa-arrow-down" /></button>
            <button><span class="fas fa-comment" /></button>
            <details class="dropdown">
                <summary role="button">
                    <span class="fas fa-bookmark" />
                </summary>
                <ul>
                    <li><a href="#">Favorite</a></li>
                    <li><a href="#">New Collection</a></li>
                </ul>
            </details>

        </div>
    </footer>
</article>
@model Recipe
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userVote = Model.Votes.FirstOrDefault(v => v.ApplicationUserId == currentUser?.Id);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var averageRating = Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0;
    var reviewCount = Model.Reviews.Count;
}

<article>
    <header>
        <strong>@Model.Title</strong>
        <br />
        <a asp-controller="User" asp-action="Profile" asp-route-username="@Model.Author.UserName">
            <small>- @Model.Author.DisplayName</small>
        </a>
    </header>
    <p>@Model.MainText</p>
    <time datetime="@Model.CreatedAt.ToUniversalTime():O">@Model.CreatedAt.ToLocalTime()</time>
    <footer>
        <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
            @{
                var vc = new Website.Models.ViewModels.VoteControlsViewModel
                {
                    ContentId = Model.Id,
                    Score = Model.Score,
                    UserVote = userVote?.VoteType,
                    CanVote = currentUser != null,
                    ReturnUrl = returnUrl ?? string.Empty
                };
            }
            @if (reviewCount > 0)
            {
                <button type="button" class="secondary outline" style="margin: 0; padding: 0.5rem 0.75rem;" title="Average rating">
                    <span class="fas fa-star"></span> @averageRating.ToString("0.0") (@reviewCount)
                </button>
            }
            @await Html.PartialAsync("_VoteControls", vc)
            <button type="button" class="secondary outline" onclick="window.location.href='@Url.Action("Post", "Home", new { id = Model.Id })'" title="Comments" style="margin: 0; padding: 0.5rem 0.75rem;">
                <span class="fas fa-comment"></span>
            </button>

            @* Save to Collection (feed) *@
            @{
                var userCollections = ViewData["UserCollections"] as List<Collection> ?? new List<Collection>();
            }
            @if (currentUser != null)
            {
                <div style="position:relative;">
                    <button type="button" class="secondary outline" onclick="var el=document.getElementById('feed-collection-picker-@Model.Id'); el.style.display = el.style.display === 'block' ? 'none' : 'block';" title="Save" style="margin: 0; padding: 0.5rem 0.75rem;">
                        <span class="fas fa-bookmark"></span>
                    </button>
                    <div id="feed-collection-picker-@Model.Id" style="display:none; position:absolute; right:0; z-index:30; background:white; padding:0.5rem; border:1px solid #ddd; border-radius:0.25rem; min-width:200px;">
                        @if (!userCollections.Any())
                        {
                            <div>
                                <p>No collections yet.</p>
                                <p><a asp-controller="Collections" asp-action="Create">Create one</a></p>
                            </div>
                        }
                        else
                        {
                            <form asp-controller="Collections" asp-action="AddRecipe" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="recipeId" value="@Model.Id" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <label>
                                    Add to
                                    <select name="collectionId" required style="width:100%; margin-top:0.25rem;">
                                        <option value="">Choose...</option>
                                        @foreach (var c in userCollections)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                </label>
                                <div style="margin-top:0.5rem; display:flex; gap:0.5rem; justify-content:flex-end;">
                                    <button type="submit" class="button">Save</button>
                                    <button type="button" class="secondary outline" onclick="document.getElementById('feed-collection-picker-@Model.Id').style.display='none'">Cancel</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            }

            @if (currentUser != null)
            {
                <form asp-controller="Home" asp-action="SimulatePurchase" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="recipeId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" class="secondary outline" title="Simulate purchase" style="margin: 0; padding: 0.5rem 0.75rem;">
                        <span class="fas fa-basket-shopping"></span>
                    </button>
                </form>
            }
        </div>
    </footer>
</article>


@model List<Website.Models.Content>
@using Microsoft.AspNetCore.Identity
@using Website.Models.ViewModels
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
}

@if (!Model.Any())
{
    <p>No comments yet. Be the first to comment!</p>
}
else
{
    @foreach (var comment in Model)
    {
        var vc = new VoteControlsViewModel
        {
            ContentId = comment.Id,
            Score = comment.Score,
            UserVote = comment.Votes.FirstOrDefault(v => v.ApplicationUserId == currentUser?.Id)?.VoteType,
            CanVote = currentUser != null,
            ReturnUrl = Url.Action("Post", "Home", new { id = comment.ParentId }) ?? string.Empty
        };
        <article>
            <header style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-start; gap:1rem;">
                <div style="min-width:0; flex:1;">
                    <p class="text-muted" style="margin:0;">
                        By <a asp-controller="User" asp-action="Profile" asp-route-username="@comment.Author.UserName" style="color:inherit; font-weight:bold;">@comment.Author.DisplayName</a> • <small>@comment.CreatedAt.ToLocalTime().ToString("g")</small>
                    </p>
                </div>
            </header>
            <p>@comment.MainText</p>
            <footer style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
                <div style="display:flex;gap:0.5rem;align-items:center;">
                    @await Html.PartialAsync("_VoteControls", vc)
                </div>
                <div style="display:flex;gap:0.5rem;align-items:center;">
                    @if (comment.Replies.Any())
                    {
                        <button type="button" style="background:none;border:none;color:inherit;cursor:pointer;margin:0;padding:0.5rem 0.75rem;" onclick="window.location.href='@(Url.Action("Comment", "Home", new { id = comment.Id }))'">
                            <span class="fas fa-comment"></span> (@comment.Replies.Count)
                        </button>
                    }
                    @* Always show Reply link for logged-in users *@
                    @if (currentUser != null)
                    {
                        <button type="button" style="background:none;border:none;color:inherit;cursor:pointer;margin:0;padding:0.5rem 0.75rem;" onclick="window.location.href='@(Url.Action("Comment", "Home", new { id = comment.Id }))'" title="Reply" aria-label="Reply">
                            <span class="fas fa-comment"></span>
                        </button>
                    }
                </div>
            </footer>
        </article>
    }
}

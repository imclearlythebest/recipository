@model List<Recipe>

@if (!Model.Any())
{
    <article>
        <p style="text-align: center; padding: 2rem;">No recipes found. Try adjusting your filters.</p>
    </article>
}
else
{
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
        @foreach (var Post in Model)
        {   
            <partial name='_Post.cshtml' model='Post' />
        }
    </div>
}

@model ICollection<Content>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
}

@if (Model?.Any() == true)
{
    <div style="margin-top: 1rem; border-left: 2px solid var(--pico-muted-border-color); padding-left: 1rem;">
        <h5>Comments (@Model.Count)</h5>
        @foreach (var comment in Model)
        {
            <article style="margin-bottom: 1rem; padding: 0.75rem; background-color: var(--pico-form-element-background-color); border-radius: 0.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <a asp-controller="User" asp-action="Profile" asp-route-username="@comment.Author.UserName" style="font-weight: bold; text-decoration: none;">
                        @comment.Author.DisplayName
                    </a>
                    <small style="color: var(--pico-muted-color);">@comment.CreatedAt.ToString("g")</small>
                </div>
                <p style="margin: 0.5rem 0;">@comment.MainText</p>
                
                <div style="display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem; flex-wrap: wrap;">
                    <span style="font-weight: bold; min-width: 2rem; text-align: center;">@comment.Score</span>
                    @if (currentUser != null)
                    {
                        <form asp-controller="Home" asp-action="Upvote" asp-route-contentId="@comment.Id" method="post" style="margin: 0; padding: 0;">
                            <button type="submit" class="secondary outline" style="margin: 0; padding: 0.4rem 0.6rem; font-size: 0.85rem;">
                                <span class="fas fa-arrow-up" />
                            </button>
                        </form>
                        <form asp-controller="Home" asp-action="Downvote" asp-route-contentId="@comment.Id" method="post" style="margin: 0; padding: 0;">
                            <button type="submit" class="secondary outline" style="margin: 0; padding: 0.4rem 0.6rem; font-size: 0.85rem;">
                                <span class="fas fa-arrow-down" />
                            </button>
                        </form>
                    }
                    <button class="secondary outline" style="margin: 0; padding: 0.4rem 0.6rem; font-size: 0.85rem;" onclick="document.getElementById('reply-form-@comment.Id').style.display = 'block'">
                        <span class="fas fa-reply" /> Reply
                    </button>
                </div>

                @if (currentUser != null)
                {
                    <div id="reply-form-@comment.Id" style="display: none; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--pico-muted-border-color);">
                        <form asp-controller="Content" asp-action="AddReply" asp-route-parentId="@comment.Id" method="post">
                            <textarea name="text" placeholder="Write a reply..." style="margin-bottom: 0.5rem; font-size: 0.9rem;" rows="2" required></textarea>
                            <div style="display: flex; gap: 0.5rem;">
                                <button type="submit" class="secondary" style="font-size: 0.85rem;">Reply</button>
                                <button type="button" class="secondary outline" style="font-size: 0.85rem;" onclick="document.getElementById('reply-form-@comment.Id').style.display = 'none'">Cancel</button>
                            </div>
                        </form>
                    </div>
                }

                @if (comment.Replies?.Any() == true)
                {
                    <partial name="_Comments" model="comment.Replies" />
                }
            </article>
        }
    </div>
}

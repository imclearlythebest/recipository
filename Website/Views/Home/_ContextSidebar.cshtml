@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
  var pendingReviews = ViewData["PendingRecipeReviews"] as List<RecipeReviewRequest> ?? new List<RecipeReviewRequest>();
}

<section>
  <nav>
    <ul>
      <li>
        <details class="dropdown">
          <summary role="button" class="outline">
            <span class="fas fa-plus"></span> Create
          </summary>
          <ul>
            <li><a asp-controller="Recipe" asp-action="Create">Recipe</a></li>
            <li><a asp-controller="Ingredients" asp-action="Create">Ingredient</a></li>
            @if (User.IsInRole("Admin"))
            {
              <li><a asp-controller="Ingredients" asp-action="CreateShopItem">Shop Item</a></li>
            }
          </ul>
        </details>
      </li>
    </ul>
  </nav>
</section>

@if (action == "Index")
{
  <form id="post-filter-form" hx-get="/Home/Filter" hx-target="#home-feed" hx-trigger="change, keyup delay:300ms changed">
    <section>
      <label for="post-search">Search Posts</label>
      <input type="search" id="post-search" name="search" placeholder="Search recipes..." />
    </section>

    <section>
      <h6>Filters</h6>
      <select name="sortBy">
        <option value="newest">Newest</option>
        <option value="top">Top Scored</option>
        <option value="rating">Top Rated</option>
        <option value="trending">Trending</option>
      </select>

      <fieldset>
        <label>
          <input type="radio" name="time" value="all" checked>
          All Time
        </label>
        <label>
          <input type="radio" name="time" value="today">
          Today
        </label>
        <label>
          <input type="radio" name="time" value="week">
          This Week
        </label>
      </fieldset>

      @if (User.Identity?.IsAuthenticated == true)
      {
        <label>
          <input type="checkbox" id="feed-type-toggle" name="feedType" value="followers" onchange="this.value = this.checked ? 'followers' : 'global'; htmx.trigger('#post-filter-form', 'change');" role="switch" />
          Following Only
        </label>
      }
    </section>
  </form>

}
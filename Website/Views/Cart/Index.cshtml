@model IEnumerable<Website.Models.CartItem>

@{
  ViewData["Title"] = "Cart";
}

<main class="container" id="cart-container">
  <article>
    <header>
      <hgroup>
        <h1>Your Cart</h1>
        <p>Review and adjust your ingredients</p>
      </hgroup>
    </header>

    @if (Model == null || !Model.Any())
    {
      <p>Your cart is empty. <a href="/Marketplace">Return to Marketplace</a></p>
    }
    else
    {
      <table role="grid">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th style="text-align:center;">Quantity</th>
            <th>Subtotal</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model)
          {
            <tr>
              <td><strong>@item.Product?.Name</strong></td>
              <td>$@item.Product?.Price.ToString("F2")</td>
              <td>
                <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                  <button class="outline secondary" 
                          style="padding: 1px 8px; margin: 0;"
                          hx-post="/Cart/UpdateQuantity?id=@item.ShopItemId&change=-1"
                          hx-target="#cart-container"
                          hx-select="#cart-container">-</button>
                  
                  <span style="font-weight: bold; min-width: 20px; text-align: center;">@item.Quantity</span>
                  
                  <button class="outline secondary" 
                          style="padding: 1px 8px; margin: 0;"
                          hx-post="/Cart/UpdateQuantity?id=@item.ShopItemId&change=1"
                          hx-target="#cart-container"
                          hx-select="#cart-container">+</button>
                </div>
              </td>
              <td>$@item.Subtotal.ToString("F2")</td>
              <td>
                <button class="contrast outline" 
                        style="padding: 4px 8px;"
                        hx-post="/Cart/Remove/@item.ShopItemId" 
                        hx-target="#cart-container"
                        hx-select="#cart-container">Delete</button>
              </td>
            </tr>
          }
        </tbody>
      </table>

      <footer style="text-align: right; padding-top: 1rem;">
        <h3>Total: <span style="color: var(--pico-ins-color);">$@Model.Sum(x => x.Subtotal).ToString("F2")</span></h3>
        <a href="/Checkout" role="button" class="primary">Checkout</a>
      </footer>
    }
  </article>
</main>
@model IEnumerable<Website.Models.CartItem>

<main class="container">
  <article>
    <header>
      <h1>Shopping Cart</h1>
    </header>

    @if (!Model.Any()) {
      <p>Your cart is empty. <a asp-controller="Marketplace" asp-action="Index">Go shopping?</a></p>
    } else {
      <table class="striped">
        <thead>
          <tr>
            <th>Ingredient</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Subtotal</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model) {
            <tr id="cart-row-@item.ShopItemId">
              <td>@item.Product?.Name</td>
              <td>$@item.Product?.Price.ToString("F2")</td>
              <td>@item.Quantity</td>
              <td>$@item.Subtotal.ToString("F2")</td>
              <td>
                <button 
                  hx-post="/Cart/Remove/@item.ShopItemId" 
                  hx-target="#cart-row-@item.ShopItemId" 
                  hx-swap="outerHTML"
                  class="outline secondary"
                  style="padding: 2px 8px;">
                  Remove
                </button>
              </td>
            </tr>
          }
        </tbody>
      </table>
    }
  </article>
</main>
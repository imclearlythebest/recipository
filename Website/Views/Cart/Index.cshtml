@model IEnumerable<Website.Models.CartItem>

<main class="container">
  <article>
    <header>
      <h1>Your Shopping Cart</h1>
    </header>

    @if (!Model.Any())
    {
      <p>Your cart is empty. <a asp-controller="Marketplace" asp-action="Index">Go back to Marketplace</a></p>
    }
    else
    {
      <table class="striped">
        <thead>
          <tr>
            <th>Item</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Subtotal</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model)
          {
            <tr id="cart-row-@item.ShopItemId">
              <td>@item.Product?.Name</td>
              <td>$@item.Product?.Price.ToString("F2")</td>
              <td>@item.Quantity</td>
              <td>$@item.Subtotal.ToString("F2")</td>
              <td>
                <button 
                  hx-post="/Cart/Remove/@item.ShopItemId" 
                  hx-target="#cart-row-@item.ShopItemId" 
                  hx-swap="outerHTML"
                  class="outline secondary"
                  style="padding: 2px 10px;">
                  Remove
                </button>
              </td>
            </tr>
          }
        </tbody>
      </table>
      
      <footer>
        <div style="text-align: right;">
          <strong>Total: $@Model.Sum(i => i.Subtotal).ToString("F2")</strong>
        </div>
      </footer>
    }
  </article>
</main>
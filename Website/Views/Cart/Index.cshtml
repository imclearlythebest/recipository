@model IEnumerable<Website.Models.CartItem>

<main class="container">
    <hgroup>
        <h1>Your Shopping Cart</h1>
        <h2>Manage your selected ingredients</h2>
    </hgroup>

    <article>
        @if (!Model.Any())
        {
            <p>Your cart is empty. <a asp-controller="Marketplace" asp-action="Index">Go back to Marketplace</a></p>
        }
        else
        {
            <table class="striped">
                <thead>
                    <tr>
                        <th scope="col">Ingredient</th>
                        <th scope="col">Price</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Subtotal</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Product?.Name</td>
                            <td>$@item.Product?.Price.ToString("F2")</td>
                            <td>@item.Quantity</td>
                            <td>$@item.Subtotal.ToString("F2")</td>
                            <td>
                                <form asp-action="Remove" method="post" style="margin:0;">
                                    <input type="hidden" name="id" value="@item.ShopItemId" />
                                    <button type="submit" class="outline secondary" style="padding: 2px 10px;">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3"><strong>Total</strong></td>
                        <td><strong>$@Model.Sum(x => x.Subtotal).ToString("F2")</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
            
            <footer>
                <button>Proceed to Checkout</button>
            </footer>
        }
    </article>
</main>
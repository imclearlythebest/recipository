@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<section>
  <button type="button" onclick="window.history.back()" style="width: 100%;">
    <i class="fas fa-arrow-left"></i> Back
  </button>
</section>

@if (action == "Index")
{
  <form id="filter-form" 
        hx-get="/Marketplace/Filter" 
        hx-target="#marketplace-grid" 
        hx-trigger="change, keyup delay:300ms changed">
                   
    <section>
      <label for="search">Search</label>
      <input type="search" id="search" name="search" placeholder="Search items..." />
    </section>

    <section>
      <h6>Category</h6>
      <select name="type">
        <option value="">All Categories</option>
        <option value="Vegetable">Vegetables</option>
        <option value="Fruit">Fruits</option>
        <option value="Meat">Meat</option>
        <option value="Dairy">Dairy</option>
        <option value="Spice">Spices</option>
      </select>
    </section>

    <section>
      <label>
        <input name="hideOutOfStock" type="checkbox" role="switch" value="true" />
        Hide out of stock
      </label>
    </section>

    <section>
      <h6>Price Range</h6>
      <label>
        <input type="radio" name="priceRange" value="all" checked>
        All Prices
      </label>
      <label>
        <input type="radio" name="priceRange" value="under-10">
        Under $10
      </label>
      <label>
        <input type="radio" name="priceRange" value="10-25">
        $10 - $25
      </label>
      <label>
        <input type="radio" name="priceRange" value="over-25">
        Over $25
      </label>
    </section>
  </form>
}

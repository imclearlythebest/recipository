@model IEnumerable<Website.Models.ShopItem>

<main class="container">
  <div id="toast-container"></div>

  <hgroup>
    <h1>Ingredient Marketplace</h1>
    <p>Fresh ingredients for your next masterpiece</p>
  </hgroup>

  <div class="grid">
    @foreach (var item in Model)
    {
      <article>
        <header><strong>@item.Name</strong></header>
        <img src="@item.ImageUrl" alt="@item.Name" style="width:100%; height:150px; object-fit:cover;">
        <p><small>@item.Description</small></p>
        <footer>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span>$@item.Price.ToString("F2")</span>
            <button 
              hx-post="/Cart/AddToCart/@item.Id" 
              hx-target="#toast-container"
              hx-swap="innerHTML"
              class="outline">
              Add to Cart
            </button>
          </div>
        </footer>
      </article>
    }
  </div>
</main>

<script>
  document.body.addEventListener('htmx:afterRequest', function (evt) {
    setTimeout(() => {
      const toast = document.getElementById('cart-toast');
      if (toast) toast.remove();
    }, 3000);
  });
</script>
@model IEnumerable<Website.Models.ShopItem>

<main class="container">
    <hgroup>
        <h1>Ingredient Marketplace</h1>
        <p>Fresh ingredients for your next masterpiece</p>
    </hgroup>

    <div class="grid">
        @foreach (var item in Model)
        {
            <article>
                <header>
                    <strong>@item.Name</strong>
                </header>
                
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Name" style="width:100%; height:150px; object-fit:cover; margin-bottom:1rem;">
                }

                <p><small>@item.Description</small></p>
                
                <footer>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span>$@item.Price.ToString("F2")</span>
                        
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" style="margin-bottom: 0;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="outline" style="padding: 5px 10px; font-size: 0.8rem;">
                                <i class="fas fa-cart-plus"></i> Add
                            </button>
                        </form>
                    </div>
                </footer>
            </article>
        }
    </div>
</main>
@{
  ViewData["LayoutType"] = "RightOnly";
}

@model IEnumerable<Website.Models.ShopItem>

<main class="container">
  <hgroup>
    <h1>Marketplace</h1>
    <p>Fresh ingredients for your next recipe</p>
  </hgroup>

  @* This div is the target for htmx success/error messages *@
  <div id="cart-toast"></div>

  @* Forced 3-column layout as per original style *@
  <div class="grid" style="grid-template-columns: repeat(3, 1fr); gap: 2rem;">
    @foreach (var item in Model)
    {
      bool isOutOfStock = item.Stock <= 0 || item.Price <= 0;

      <article style="display: flex; flex-direction: column; justify-content: space-between; margin-bottom: 0;">
        <header style="padding: 0;">
          <div style="position: relative;">
            <img src="@item.ImageUrl" 
                 alt="@item.Name" 
                 style="width: 100%; height: 200px; object-fit: cover; @(isOutOfStock ? "filter: grayscale(100%); opacity: 0.5;" : "")" />
            
            @if (isOutOfStock)
            {
              <div style="position: absolute; bottom: 0; left: 0; width: 100%;
                          background: rgba(192, 57, 43, 0.9); color: white; padding: 5px 0; 
                          font-weight: bold; text-transform: uppercase; z-index: 10; text-align: center;
                          font-size: 0.8rem; letter-spacing: 1px;">
                Out of Stock
              </div>
            }
          </div>
        </header>

        <div style="padding: 1rem;">
          <h4 style="margin-bottom: 0.5rem;">@item.Name</h4>
          <p style="font-size: 0.9rem; margin-bottom: 0.5rem;">@item.Description</p>
          
          @* Target for OOB swap: update the number instantly *@
          <small id="stock-@item.Id" style="color: var(--pico-muted-color);">In Stock: @item.Stock</small>
        </div>
        
        <footer style="padding: 1rem; border-top: 1px solid var(--pico-muted-border-color);">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: bold; font-size: 1.1rem;">
              $@item.Price.ToString("F2")
            </span>
            
            @if (isOutOfStock)
            {
              <button class="secondary outline" disabled style="margin: 0; cursor: not-allowed; font-size: 0.8rem;">
                Stock Out
              </button>
            }
            else
            {
              <button class="primary" 
                      style="margin: 0; font-size: 0.8rem;"
                      hx-post="/Cart/AddToCart/@item.Id" 
                      hx-swap="none">
                Add to Cart
              </button>
            }
          </div>
        </footer>
      </article>
    }
  </div>
</main>
@model IEnumerable<Website.Models.ShopItem>

<style>
    /* This forces the grid to wrap and stay at 3 items per row */
    .marketplace-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 20px; /* Space between the cards */
    }

    .marketplace-grid article {
        /* (100% / 3) minus a bit for the gaps = approx 31% */
        flex: 0 0 calc(33.333% - 20px); 
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
    }

    /* Responsive: on small screens (phones), show 1 item per row */
    @@media (max-width: 768px) {
        .marketplace-grid article {
            flex: 0 0 100%;
        }
    }
</style>

<main class="container">
  <div id="toast-container"></div>
  
  <hgroup>
    <h1>Marketplace</h1>
    <p>Browsing our fresh ingredients</p>
  </hgroup>

  <div class="marketplace-grid">
    @foreach (var item in Model)
    {
      <article>
        <header>
          <strong style="font-size: 1.2rem;">@item.Name</strong>
          <span style="float: right; font-size: 0.8rem; color: #888;">@item.Calories kcal</span>
        </header>
        
        <img src="@item.ImageUrl" alt="@item.Name" style="height:200px; width:100%; object-fit:cover; border-radius: 8px;">
        
        <div style="padding: 10px 0;">
            <small>@item.Description</small><br/>
            <small>Stock: <strong>@item.Stock</strong></small>
        </div>

        <footer style="margin-top: auto;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <ins style="font-size: 1.25rem; text-decoration: none; font-weight: bold;">
                $@item.Price.ToString("F2")
            </ins>
            <button 
              hx-post="/Cart/AddToCart/@item.Id" 
              hx-target="#toast-container" 
              hx-swap="innerHTML"
              class="outline">
              Add to Cart
            </button>
          </div>
        </footer>
      </article>
    }
  </div>
</main>

<script>
  document.body.addEventListener('htmx:afterRequest', function (evt) {
    setTimeout(() => {
      const toast = document.getElementById('cart-toast');
      if (toast) toast.remove();
    }, 3000);
  });
</script>
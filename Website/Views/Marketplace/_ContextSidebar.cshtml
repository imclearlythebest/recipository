@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<section>
  <div class="grid">
    <button type="button" onclick="window.history.back()" class="outline secondary">
      <i class="fas fa-arrow-left"></i> Back
    </button>
    <button type="button" onclick="window.location.href='/Cart'" class="secondary">
      <i class="fas fa-shopping-cart"></i> Cart
    </button>
  </div>
</section>

@if (action == "Index")
{
  <form id="filter-form" 
        hx-get="/Marketplace/Filter" 
        hx-target="#marketplace-grid" 
        hx-trigger="change, keyup delay:300ms changed">
                   
    <section>
      <label for="search">Search</label>
      <input type="search" id="search" name="search" placeholder="Search items..." />
    </section>

    <section>
      <h6>Category</h6>
      <select name="type">
        <option value="">All Categories</option>
        <option value="Vegetable">Vegetables</option>
        <option value="Fruit">Fruits</option>
        <option value="Meat">Meat</option>
        <option value="Dairy">Dairy</option>
        <option value="Spice">Spices</option>
      </select>
    </section>

    <section>
      <label>
        <input name="hideOutOfStock" type="checkbox" role="switch" value="true" />
        Hide out of stock
      </label>
    </section>

    <section>
      <h6>Price Range</h6>
      <label>
        <input type="radio" name="priceRange" value="all" checked>
        All Prices
      </label>
      <label>
        <input type="radio" name="priceRange" value="under-100">
        Under ৳100
      </label>
      <label>
        <input type="radio" name="priceRange" value="100-500">
        ৳100 - ৳500
      </label>
      <label>
        <input type="radio" name="priceRange" value="over-500">
        Over ৳500
      </label>
    </section>
  </form>
}
